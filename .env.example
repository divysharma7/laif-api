# Required at runtime
NODE_ENV=development
PORT=4000
JWT_SECRET=your-jwt-secret-min-32-chars-long
DATABASE_URL=postgresql://user:pass@host:5432/laif?sslmode=require

# CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Dev Mode
DEV_USER_ID=6a0ace89bbece9a4ac3e81c9

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Background inbound-sync cadence (minutes)
GOOGLE_SYNC_INTERVAL_MINUTES=5

# AI (optional)
OPENROUTER_API_KEY=
