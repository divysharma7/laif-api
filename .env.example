# Required at runtime
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-me-with-at-least-32-random-characters
DATABASE_URL=postgresql://app:replace-me@localhost:5432/lifeos

# CORS
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Development-only authenticated-user bypass. Leave empty outside local dev.
DEV_USER_ID=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
# Generate a 32-byte base64 value and store it in the platform secret store.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-value
# Background inbound-sync cadence (minutes)
GOOGLE_SYNC_INTERVAL_MINUTES=5

# Reserved for a future explicitly-approved external AI provider. The current
# assistant is local and does not transmit user content outside this API.
OPENROUTER_API_KEY=
