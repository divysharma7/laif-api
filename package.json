{
  "name": "laif-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:secrets": "node scripts/check-secrets.mjs",
    "verify:focus-migration": "node scripts/verify-focus-migration.mjs",
    "test:e2e:safety": "node --test scripts/e2e-safety.test.mjs",
    "test:e2e:fullstack": "node scripts/run-fullstack-e2e.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migration:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^171.4.0",
    "jose": "^5.2.3",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "bun": "^1.3.14",
    "pino-pretty": "^11.0.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  }
}
